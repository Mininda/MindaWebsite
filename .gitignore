# Public deployment allowlist. New files stay local until explicitly approved.
# In particular, do not publish file/, assets/files/, .preview/, or HTML trials.
*
!*/
!/.gitignore
!/.nojekyll
!/CNAME
!/index.html

# Styles used by the approved homepage, plus the upstream license.
!/assets/css/fonts.css
!/assets/css/institution-logos.css
!/assets/css/minimal-light.css
!/assets/css/news-logos.css
!/assets/css/portrait-small.css
!/assets/css/publications.css
!/assets/css/site.css
